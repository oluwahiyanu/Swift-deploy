# Generated by: swiftdeploy init
# Source of truth: manifest.yaml
# DO NOT EDIT - regenerate with: swiftdeploy init

networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  app-logs:
    driver: local
  nginx-logs:
    driver: local

services:

  app:
    image: {{ service_image }}
    container_name: swiftdeploy-app
    restart: unless-stopped
    networks:
      - {{ network_name }}

    environment:
      MODE:        "{{ mode }}"
      APP_VERSION: "{{ app_version }}"
      APP_PORT:    "{{ service_port }}"

    user: "1001:1001"
    read_only: false
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE

    volumes:
      - app-logs:/app/logs

    healthcheck:
      test: ["CMD", "python3", "-c",
             "import urllib.request; urllib.request.urlopen('http://localhost:{{ service_port }}/healthz')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 256M

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: unless-stopped
    networks:
      - {{ network_name }}

    ports:
      - "{{ nginx_port }}:80"

    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - nginx-logs:/var/log/nginx

    depends_on:
      app:
        condition: service_healthy

    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
