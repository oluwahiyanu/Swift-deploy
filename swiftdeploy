def print_help():
    print(f"""
{BOLD}SwiftDeploy CLI{RESET}

Commands:
  init        Generate nginx.conf and docker-compose.yml from templates
  validate    Check manifest.yaml exists and is valid
  deploy      Full deploy: init → validate → OPA check → docker compose up
  promote     Promote to canary or stable mode
  status      Live dashboard with metrics and OPA compliance
  audit       Generate audit_report.md from history.jsonl
  teardown    Stop and optionally remove containers

Examples:
  ./swiftdeploy deploy
  ./swiftdeploy promote canary
  ./swiftdeploy status
  ./swiftdeploy teardown --clean
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == "init":
        cmd_init()
    elif cmd == "validate":
        cmd_validate()
    elif cmd == "deploy":
        cmd_deploy()
    elif cmd == "promote":
        if len(sys.argv) < 3:
            fail("promote requires a mode: canary or stable")
            sys.exit(1)
        cmd_promote(sys.argv[2])
    elif cmd == "status":
        cmd_status()
    elif cmd == "audit":
        cmd_audit()
    elif cmd == "teardown":
        cmd_teardown("--clean" in sys.argv)
    else:
        fail(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()